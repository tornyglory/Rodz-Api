    "@types/node": "^22.0.0",
    "aws-cdk": "2.160.0",
    "esbuild": "^0.28.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.0",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1075.0",
